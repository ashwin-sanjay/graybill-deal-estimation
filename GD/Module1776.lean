theorem d029596 {t : ℝ} (ht : 0 < t) :
    Real.exp (-t) / (1 - Real.exp (-t)) = 1 / (Real.exp t - 1) := by
  have he : Real.exp t ≠ 0 := (Real.exp_pos t).ne'
  have he1 : Real.exp t - 1 ≠ 0 :=
    (sub_pos.mpr (Real.one_lt_exp_iff.mpr ht)).ne'
  have hden : 1 - Real.exp (-t) ≠ 0 :=
    (sub_pos.mpr (Real.exp_lt_one_iff.mpr (neg_lt_zero.mpr ht))).ne'
  apply (div_eq_iff hden).2
  rw [Real.exp_neg]
  field_simp [he, he1]
  <;> ring



